OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low

SECRET_KEY=

FREE_WELCOME_LIMIT=10
FREE_DAILY_LIMIT=3
BILLING_TIMEZONE=Asia/Ho_Chi_Minh

PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

PUBLIC_BASE_URL=
SESSION_COOKIE_SECURE=false
PAYMENT_ALLOW_LOCALHOST=true
# Module học ngoại ngữ nhập vai
OPENAI_LANGUAGE_MODEL=gpt-5.6-luna
OPENAI_LANGUAGE_REASONING_EFFORT=low
OPENAI_LANGUAGE_MAX_OUTPUT_TOKENS=1400
LANGUAGE_MAX_MESSAGE_CHARS=500

PLATFORM_BRAND_NAME=Mở Lối
PLATFORM_BRAND_TAGLINE=Học tập · Sự nghiệp · Cuộc sống

# Security baseline
APP_ENV=development
FLASK_DEBUG=false
SESSION_COOKIE_SECURE=false
MAX_REQUEST_BYTES=62914560
TRUST_PROXY_HEADERS=false
TRUSTED_HOSTS=
LEGAL_POLICY_VERSION=2026-08-08-v1
REQUIRE_LEGAL_CONSENT=true
# Production/Render: APP_ENV=production, SESSION_COOKIE_SECURE=true, TRUST_PROXY_HEADERS=true
# Set SECRET_KEY to a long random value in production. Never commit it.

# Multimodal chat attachments
CHAT_STORAGE_DIR=storage
CHAT_IMAGE_MAX_BYTES=26214400
CHAT_ATTACHMENT_MAX_BYTES=52428800
CHAT_ATTACHMENT_TOTAL_MAX_BYTES=52428800
CHAT_ATTACHMENT_MAX_FILES=10

# Image generation uses the Responses API image_generation tool.
OPENAI_IMAGE_TOOL_MODEL=gpt-5.6

# Automatic model routing (chat UI stays on Auto)
# Fast: casual/simple chat and lightweight questions.
OPENAI_FAST_MODEL=gpt-5.6-luna
# Smart: translation, documents, analysis, normal coding/professional work.
OPENAI_SMART_MODEL=gpt-5.6-terra
# Heavy: complex multi-file coding, deep research/reasoning, hard technical work.
OPENAI_HEAVY_MODEL=gpt-5.6-sol
# Images: Terra rewrites/coordinates normal image prompts; Sol is reserved for complex edits.
OPENAI_IMAGE_SMART_MODEL=gpt-5.6-terra
OPENAI_IMAGE_HEAVY_MODEL=gpt-5.6-sol

# Large file transformations / translations
OPENAI_ARTIFACT_MAX_OUTPUT_TOKENS=32768
OPENAI_ARTIFACT_RETRY_MAX_OUTPUT_TOKENS=65536

# ===== Production database =====
# Local development keeps DATABASE_PATH=app.db.
DATABASE_PATH=app.db
# Render injects this automatically from Render Postgres. Leave blank locally.
DATABASE_URL=
REQUIRE_POSTGRES=false

# ===== Cloudflare R2 private object storage =====
# Leave these blank locally to keep using ./storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PRESIGN_TTL=600
REQUIRE_R2_STORAGE=false
